{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WaW FX Viewer",
  "version": "0.1.0",
  "identifier": "com.phil81334.waw-fx-viewer",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1427",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "WaW FX Viewer",
        "url": "index.html",
        "width": 1260,
        "height": 860,
        "minWidth": 900,
        "minHeight": 650,
        "backgroundColor": "#191e23"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1427; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
